# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=btech_nlp_secret_key_change_in_production_2026

# Storage Paths
DATABASE_PATH=data/semantic_search.db
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB

# NLP & Retrieval Settings
DEFAULT_SEARCH_MODE=hybrid   # options: hybrid, semantic, keyword, inverted_index
DEFAULT_TOP_K=5
DEFAULT_HYBRID_ALPHA=0.5     # 0.0 = 100% semantic, 1.0 = 100% keyword
CHUNK_SIZE=200               # words per chunk
CHUNK_OVERLAP=40             # words overlap

# Pretrained Transformer Models
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
ATTENTION_MODEL_NAME=bert-base-uncased

# LLM / RAG Settings
LLM_PROVIDER=extractive_fallback  # options: ollama, openai_compatible, extractive_fallback
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
